%% multicancel.sty
%% Package for advanced, fully extendable, tallable, and colored parallel cancellations
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{multicancel}[2026/09/27 v1.4 Advanced Multi-line Cancellations]

\RequirePackage{amsmath}
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{xparse}
\usetikzlibrary{calc,arrows.meta}

\makeatletter
% Configuration state containers
\newcommand{\multicancel@count}{1}
\newcommand{\multicancel@color}{black}
\newcommand{\multicancel@type}{c} 
\newcommand{\multicancel@target}{}

% Storage macros to completely isolate mathpalette parameters from TikZ loops
\newcommand{\multicancel@savedstyle}{}
\newcommand{\multicancel@savedbody}{}

% Internal drawing block - strictly loops over safely stored external commands
\newcommand{\multicancel@render}{%
  \begin{tikzpicture}[baseline=(content.base), label distance=0pt]
    \node[inner sep=0pt, outer sep=0pt] (content) {\ensuremath{\multicancel@savedstyle\multicancel@savedbody}};
    \foreach \multicancel@i in {1,...,\multicancel@count} {
      \pgfmathsetmacro{\multicancel@t}{\multicancel@count > 1 ? (\multicancel@i - 1)/(\multicancel@count - 1) : 0.5}
      \pgfmathsetmacro{\multicancel@offset}{(\multicancel@t - 0.5) * 4.5pt}
      \tikzset{cancel@style/.style={draw=\multicancel@color, line cap=round, shorten <= -1.5pt, shorten >= -1.5pt}}
      
      % Type 1: \multicancel
      \if\multicancel@type c
        \draw[cancel@style] ($(content.south west) + (\multicancel@offset, 0)$) -- ($(content.north east) + (\multicancel@offset, 0)$);
      \fi
      % Type 2: \multibcancel
      \if\multicancel@type b
        \draw[cancel@style] ($(content.north west) + (\multicancel@offset, 0)$) -- ($(content.south east) + (\multicancel@offset, 0)$);
      \fi
      % Type 3: \multixcancel
      \if\multicancel@type x
        \draw[cancel@style] ($(content.south west) + (\multicancel@offset, 0)$) -- ($(content.north east) + (\multicancel@offset, 0)$);
        \draw[cancel@style] ($(content.north west) + (\multicancel@offset, 0)$) -- ($(content.south east) + (\multicancel@offset, 0)$);
      \fi
      % Type 4: \multicancelto
      \if\multicancel@type t
        \ifnum\multicancel@i=\multicancel@count
          \draw[cancel@style, -{Stealth[scale=0.8]}] ($(content.south west) + (\multicancel@offset, 0)$) -- ($(content.north east) + (\multicancel@offset, 0)$)
            node[anchor=south west, inner sep=0.5pt, font=\scriptsize, text=\multicancel@color] {\ensuremath{\multicancel@savedstyle\multicancel@target}};
        \else
          \draw[cancel@style] ($(content.south west) + (\multicancel@offset, 0)$) -- ($(content.north east) + (\multicancel@offset, 0)$);
        \fi
      \fi
    }
  \end{tikzpicture}%
}

% Mid-level layout router - safely maps parameters to static memory before loop execution
\newcommand{\multicancel@unpack}[2]{%
  \def\multicancel@savedstyle{#1}%
  \def\multicancel@savedbody{#2}%
  \multicancel@render
}

% --- Core User Commands ---
\NewDocumentCommand{\multicancel}{O{1} O{black} m}{%
  \def\multicancel@count{#1}\def\multicancel@color{#2}\def\multicancel@type{c}%
  \relax\ifmmode\mathpalette{\multicancel@unpack}{#3}\else\multicancel@unpack{\textstyle}{\text{#3}}\fi
}

\NewDocumentCommand{\multibcancel}{O{1} O{black} m}{%
  \def\multicancel@count{#1}\def\multicancel@color{#2}\def\multicancel@type{b}%
  \relax\ifmmode\mathpalette{\multicancel@unpack}{#3}\else\multicancel@unpack{\textstyle}{\text{#3}}\fi
}

\NewDocumentCommand{\multixcancel}{O{1} O{black} m}{%
  \def\multicancel@count{#1}\def\multicancel@color{#2}\def\multicancel@type{x}%
  \relax\ifmmode\mathpalette{\multicancel@unpack}{#3}\else\multicancel@unpack{\textstyle}{\text{#3}}\fi
}

\NewDocumentCommand{\multicancelto}{O{1} O{black} m m}{%
  \def\multicancel@count{#1}\def\multicancel@color{#2}\def\multicancel@type{t}\def\multicancel@target{#3}%
  \relax\ifmmode\mathpalette{\multicancel@unpack}{#4}\else\multicancel@unpack{\textstyle}{\text{#4}}\fi
}

\makeatother
\endinput
